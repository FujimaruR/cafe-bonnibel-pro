  "text.b885e27ea9": {
    "es": "Nuestro espacio",
    "en": "Our space"
  },
  "text.d5e3f25d94": {
    "es": "Un ambiente cálido pensado para disfrutar café con calma. Luz suave, madera natural y mesas para conversar o estudiar.",
    "en": "A warm space for enjoying coffee at your own pace. Soft light, natural wood and tables for conversations or studying."
  },
  "text.63e7cb7598": {
    "es": "Nuestra historia",
    "en": "Our story"
  },
  "text.2660104da4": {
    "es": "Nacimos con una idea simple: café de origen y pan artesanal, servidos con calma. Trabajamos con fincas locales y recetas de temporada.",
    "en": "We started with a simple idea: single-origin coffee and artisan bread, served at an unhurried pace. We work with local farms and seasonal recipes."
  },
  "text.f811b4156f": {
    "es": "Cada taza se tuesta y muele al momento. Nuestro espacio busca ser una pausa bonita en tu día.",
    "en": "Each cup is freshly roasted and ground. Our space offers a pleasant pause in your day."
  },
